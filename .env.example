# ==============================================================================
# REALITY MIND CLINIC (RMC) - ENVIRONMENT VARIABLES
# ==============================================================================

# 1. Supabase Database & Authentication Configuration
# Dashboard: https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 2. Cloudinary Video & Media Storage Configuration
# Dashboard: https://cloudinary.com/console
# 1. Copy your "Cloud Name" from Cloudinary Dashboard
# 2. Go to Settings (gear icon) -> Upload -> Scroll down to "Upload presets"
# 3. Click "Add upload preset", set Signing Mode to "Unsigned", Folder: "rmc_videos", Save
# 4. Copy the preset name and paste below
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
